
import java.util.Scanner;
public class home105{
  public static void main (String [] args){

    Scanner sc = new Scanner (System.in);
    int [] mark = {85, 90, 75, 44, 99};
    String [] names = {"Henry", "Mari", "Herry", "Jack", "Lily", "Oliver"};    

    //sort array 
    for(int i =0; i<mark.length ; i++){
      for(int j = 0 ; j<mark.length-1-i ; j++){
        if(mark[j]>mark[j+1]){
          int temp = mark[j];
          mark[j] = mark[j+1];
          mark[j+1]= temp;
          
          String t= names[j];
          names[j]= names[j+1];
          names[j+1]= t;
          
        }
      }
    }
    //printing sorted array
    for(int i =0; i<mark.length ; i++){
    System.out.printf( names[i] +" " +mark[i]+"\n");
    }
  
  
  }
}