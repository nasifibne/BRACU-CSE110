public class INt {
    public static void main(String[]args){
        String s1="123";
        int a=0;
        int l=s1.length()-1;
        for(int i=0; i<s1.length(); i++){
            char b=s1.charAt(i);
            int c=b-'0';
            a+=(c*Math.pow(10,l--));
        }
        System.out.println(a);
    }
}
