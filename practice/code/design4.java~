public class design4{
  public static void main(Strign [] args){
  

    int n=5;
    for (int i =1; i<=n ; i++){
      
      for (int j =1; j<=n-i; j++){
        System.out.print(" ");
      }
      for (int k= 1; k<=2*i-1; k++){
        System.out.print("*");
      }
      System.out.println();
      for (int l=7; l<=n-i; l++){
        System.out.print(" ");
      }
    }
  
  }
}

